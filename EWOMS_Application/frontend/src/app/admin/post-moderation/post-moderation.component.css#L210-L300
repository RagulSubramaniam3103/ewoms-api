/* ADAPTIVE IMAGE REVIEWER STYLES */
.reviewer-console {
  background: #0f172a;
  width: auto; /* 👈 THE "JUST IMAGE" FIX: Modal shrinks to image size */
  max-width: 90vw;
  max-height: 90vh;
  border-radius: 28px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 40px 100px -20px rgba(0,0,0,0.6);
  animation: modalScale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: inline-block; /* 👈 Wrap content */
}

@keyframes modalScale {
  from { transform: scale(0.9) translateY(40px); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}

.modal-close-fixed {
  position: absolute;
  top: 1.25rem;
  right: 1.25rem;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: white;
  font-size: 1.5rem;
  cursor: pointer;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}
.modal-close-fixed:hover { background: rgba(239, 68, 68, 0.9); transform: rotate(90deg); }

.reviewer-viewport {
  width: 100%;
  height: auto;
  min-height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.reviewer-viewport img {
  display: block;
  max-width: 90vw;
  max-height: 85vh;
  object-fit: contain; /* 👈 THE ZOOM OUT / FIT FIX */
  border-radius: 24px;
}

/* IDENTITY OVERLAY (ALIGNED TO IMAGE) */
.reviewer-identity {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  display: flex;
  flex-direction: column;
  color: white;
  text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  pointer-events: none;
  z-index: 5;
}

.ri-name { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.02em; }
.ri-date { font-size: 0.8rem; font-weight: 700; opacity: 0.8; margin-top: 0.2rem; }

/* FLOATING ACTION DOCK (ANCHORED TO BOTTOM) */
.reviewer-dock {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 0.75rem;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20px);
  padding: 0.6rem;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 15px 30px rgba(0,0,0,0.4);
  z-index: 10;
}

.dock-act {
  padding: 0.75rem 1.25rem;
  border-radius: 12px;
  border: none;
  font-weight: 800;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}

.dock-act.blur { background: white; color: #0f172a; }
.dock-act.archive { background: #ef4444; color: white; }
.dock-act:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.3); }

/* ARCHIVE REASON DISPLAY */
.reviewer-reason {
  position: absolute;
  top: 5rem;
  left: 1.5rem;
  max-width: 260px;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(239, 68, 68, 0.3);
  color: #fee2e2;
  padding: 1rem;
  border-radius: 12px;
  font-size: 0.85rem;
  z-index: 5;
}
